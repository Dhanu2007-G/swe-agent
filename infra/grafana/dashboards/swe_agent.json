{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "gauge", "name": "Gauge", "version": ""},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "panel", "id": "histogram", "name": "Histogram", "version": ""}
  ],
  "annotations": {"list": []},
  "description": "SWE Agent — Production Observability Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 50},
              {"color": "green", "value": 70}
            ]
          },
          "unit": "percent",
          "min": 0, "max": 100
        }
      },
      "gridPos": {"h": 6, "w": 5, "x": 0, "y": 1},
      "id": 1,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true},
      "title": "Solve Rate (24h)",
      "type": "gauge",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "100 * sum(rate(swe_agent_runs_total{status=\"succeeded\"}[24h])) / sum(rate(swe_agent_runs_total[24h]))",
          "legendFormat": "Solve Rate %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "blue", "mode": "fixed"},
          "unit": "short"
        }
      },
      "gridPos": {"h": 3, "w": 4, "x": 5, "y": 1},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "title": "Active Runs",
      "type": "stat",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "swe_agent_active_runs",
          "legendFormat": "Active",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"fixedColor": "green", "mode": "fixed"}, "unit": "short"}
      },
      "gridPos": {"h": 3, "w": 4, "x": 9, "y": 1},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["sum"]}},
      "title": "Runs Today",
      "type": "stat",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(swe_agent_runs_total[24h]))",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "s", "color": {"mode": "palette-classic"}}
      },
      "gridPos": {"h": 3, "w": 4, "x": 13, "y": 1},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["mean"]}},
      "title": "Avg Run Duration",
      "type": "stat",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.5, sum(rate(swe_agent_run_duration_seconds_bucket[1h])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"fixedColor": "yellow", "mode": "fixed"}}
      },
      "gridPos": {"h": 3, "w": 4, "x": 17, "y": 1},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["mean"]}},
      "title": "Avg Tokens / Run",
      "type": "stat",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.5, sum(rate(swe_agent_tokens_used_bucket[1h])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 7},
      "id": 200,
      "title": "Run Trends",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "short"},
        "overrides": [
          {"matcher": {"id": "byName", "options": "succeeded"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "failed"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "partial"}, "properties": [{"id": "color", "value": {"fixedColor": "yellow", "mode": "fixed"}}]}
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 10,
      "options": {"legend": {"calcs": ["sum"], "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "title": "Runs by Status",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (status) (rate(swe_agent_runs_total[5m])) * 300", "legendFormat": "{{status}}", "refId": "A"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "palette-classic"}}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 11,
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "list"}, "tooltip": {"mode": "multi"}},
      "title": "Run Duration Percentiles",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.5, sum(rate(swe_agent_run_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.9, sum(rate(swe_agent_run_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p90", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.99, sum(rate(swe_agent_run_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C"}
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 16},
      "id": 300,
      "title": "Self-Correction & Cost",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17},
      "id": 20,
      "options": {"legend": {"calcs": ["mean"], "displayMode": "list"}, "tooltip": {"mode": "multi"}},
      "title": "Retry Depth Distribution",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.5, sum(rate(swe_agent_retries_bucket[5m])) by (le, final_status))", "legendFormat": "{{final_status}} p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.9, sum(rate(swe_agent_retries_bucket[5m])) by (le, final_status))", "legendFormat": "{{final_status}} p90", "refId": "B"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17},
      "id": 21,
      "options": {"legend": {"calcs": ["mean", "sum"], "displayMode": "list"}},
      "title": "Token Usage (Claude tokens / 5m)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (model) (rate(swe_agent_tokens_used_sum[5m]))", "legendFormat": "{{model}}", "refId": "A"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "color": {"mode": "palette-classic"}}},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 26},
      "id": 22,
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "list"}},
      "title": "Cost Per Run ($ USD)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.5, sum(rate(swe_agent_run_cost_usd_bucket[5m])) by (le))", "legendFormat": "p50 cost", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(swe_agent_run_cost_usd_bucket[5m])) by (le))", "legendFormat": "p95 cost", "refId": "B"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 26},
      "id": 23,
      "options": {"legend": {"displayMode": "list"}},
      "title": "Queue Depth & Latency",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "swe_agent_queue_depth", "legendFormat": "{{queue_name}} depth", "refId": "A"}
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 34},
      "id": 500,
      "title": "Sandbox & Failure Analytics",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 35},
      "id": 40,
      "options": {"legend": {"displayMode": "list"}},
      "title": "Failure Categories",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (status) (rate(swe_agent_runs_total{status=~\"failed|partial\"}[5m]))", "legendFormat": "{{status}}", "refId": "A"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "palette-classic"}}},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 35},
      "id": 41,
      "options": {"legend": {"displayMode": "list"}},
      "title": "Sandbox Duration & Failure Rate",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.9, sum(rate(swe_agent_sandbox_execution_seconds_bucket[5m])) by (le))", "legendFormat": "p90 duration", "refId": "A"}
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 43},
      "id": 400,
      "title": "HTTP API",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}}},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 44},
      "id": 30,
      "options": {"legend": {"displayMode": "list"}},
      "title": "API Request Rate",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (endpoint, status) (rate(http_requests_total[1m]))", "legendFormat": "{{endpoint}} {{status}}", "refId": "A"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "palette-classic"}}},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 44},
      "id": 31,
      "options": {"legend": {"displayMode": "list"}},
      "title": "API Latency p95",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{endpoint}}", "refId": "A"}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["swe-agent", "production"],
  "templating": {"list": []},
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "SWE Agent — Production",
  "uid": "swe-agent-prod",
  "version": 1
}
